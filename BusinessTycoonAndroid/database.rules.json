{
  "rules": {
    "bizmagnat": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "leaderboard": {
        ".read": "auth != null",
        ".indexOn": [
          "netWorth"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'netWorth', 'level']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('netWorth').isNumber() && newData.child('level').isNumber()"
        }
      }
    }
  }
}
